FROM docker.io/rockylinux:9

ENV PKG_CONFIG_PATH=/usr/local/lib/pkgconfig:/usr/local/lib64/pkgconfig:${PKG_CONFIG_PATH}

RUN dnf install -y dnf-plugins-core epel-release && \
    rpm --import /etc/pki/rpm-gpg/RPM-GPG-KEY-EPEL-9 2>/dev/null || true && \
    dnf config-manager --set-enabled crb || true && \
    dnf install --enablerepo=epel,crb -y \
    perl perl-core perl-App-cpanminus perl-local-lib perl-Template-Toolkit perl-LWP-Protocol-https perl-IO-Socket-SSL \
    perl-Path-Tiny perl-Log-Any perl-Capture-Tiny perl-URI perl-File-Which \
    perl-JSON-XS perl-JSON-MaybeXS perl-Moo perl-Type-Tiny perl-Test-Exception perl-Test-Deep perl-Test-MockModule perl-PDL \
    gcc gcc-c++ make openssl-devel libnghttp2-devel libcurl-devel pcre2-devel pkgconfig which protobuf-compiler && \
    curl -L -O https://github.com/nghttp2/nghttp2/releases/download/v1.64.0/nghttp2-1.64.0.tar.gz && \
    tar -xf nghttp2-1.64.0.tar.gz && \
    cd nghttp2-1.64.0 && \
    ./configure --prefix=/usr/local --disable-app && \
    make -j$(nproc) && \
    make install && \
    cd .. && \
    rm -rf nghttp2-1.64.0 nghttp2-1.64.0.tar.gz && \
    ldconfig && \
    cpanm AnyEvent && \
    cpanm --verbose Net::HTTP2::nghttp2 && \
    cpanm ExtUtils::CppGuess Net::Curl Future Protocol::HTTP2 Module::Starter Test::LWP::UserAgent LWP::UserAgent Perl::Tidy Perl::Critic Test::Perl::Critic Test::CPAN::Changes Test::Kwalitee Test::PerlTidy Perl::Critic::Community Perl::Critic::Policy::RegularExpressions::RequireDefault Perl::Critic::Policy::Security::RandBytesFromHash && \
    ln -sf /usr/local/bin/cpanm /usr/bin/cpanm 2>/dev/null || true && \
    dnf clean all
