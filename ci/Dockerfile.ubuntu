FROM docker.io/library/ubuntu:latest

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    perl perl-modules cpanminus liblocal-lib-perl libtemplate-perl \
    gcc g++ make libssl-dev libcrypt-dev libnghttp2-dev libcurl4-openssl-dev libpcre2-dev libabsl-dev pkg-config protobuf-compiler \
    libwww-perl libjson-xs-perl libjson-maybexs-perl libmoo-perl libtype-tiny-perl \
    libpath-tiny-perl liblog-any-perl libcapture-tiny-perl liburi-perl libfile-which-perl libmodule-starter-perl \
    libtest-exception-perl libtest-deep-perl libtest-mockmodule-perl pdl && \
    cpanm ExtUtils::CppGuess AnyEvent Net::HTTP2::nghttp2 Net::Curl Future Protocol::HTTP2 Test::LWP::UserAgent Perl::Tidy Perl::Critic Test::Perl::Critic Test::CPAN::Changes Test::Kwalitee Test::PerlTidy Perl::Critic::Community Perl::Critic::Policy::RegularExpressions::RequireDefault Perl::Critic::Policy::Security::RandBytesFromHash && \

    rm -rf ~/.cpanm /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y ca-certificates lsb-release wget && \
    wget -qO /tmp/apache-arrow-apt-source.deb "https://packages.apache.org/artifactory/arrow/$(lsb_release --id --short | tr 'A-Z' 'a-z')/apache-arrow-apt-source-latest-$(lsb_release --codename --short).deb" && \
    apt-get install -y /tmp/apache-arrow-apt-source.deb && \
    rm -f /tmp/apache-arrow-apt-source.deb && \
    apt-get update && \
    apt-get install -y libarrow-dev libparquet-dev && \
    rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y libtorch-dev && \
    rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y libxgboost-dev libonnxruntime-dev libfaiss-dev libggml-dev libllama-dev libsentencepiece-dev && \
    rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y unzip && \
    wget -qO /tmp/libduckdb.zip https://github.com/duckdb/duckdb/releases/download/v1.2.1/libduckdb-linux-amd64.zip && \
    unzip -q /tmp/libduckdb.zip duckdb.h libduckdb.so -d /tmp/duckdb && \
    mv /tmp/duckdb/duckdb.h /usr/local/include/ && \
    mv /tmp/duckdb/libduckdb.so /usr/local/lib/ && \
    ldconfig && \
    rm -rf /tmp/libduckdb.zip /tmp/duckdb /var/lib/apt/lists/*
